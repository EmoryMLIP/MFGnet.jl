{
    // Julia Language Settings
    "julia.enableTelemetry": false,
    "julia.execution.resultType": "both",
    "julia.execution.codeInREPL": true,
    "julia.NumThreads": "auto",

    // Format Julia code to 92 character line length (common convention)
    "julia.format.indent": 4,
    "julia.format.kwarg": "single",

    // Editor settings
    "editor.formatOnSave": true,
    "editor.rulers": [92],
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,

    // Files settings
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true,
        "**/Manifest.toml": false  // Show Manifest.toml in file explorer
    },

    // Terminal settings
    "terminal.integrated.defaultProfile.linux": "zsh",
    "terminal.integrated.scrollback": 10000,

    // Git settings
    "git.autofetch": true,
    "git.confirmSync": false,

    // Search settings - exclude common Julia artifacts
    "search.exclude": {
        "**/.git": true,
        "**/node_modules": true,
        "**/.julia": true
    },

    // File associations
    "files.associations": {
        "*.jl": "julia"
    }
}
